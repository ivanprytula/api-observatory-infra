#!/usr/bin/env bash
set -o errexit -o pipefail -o nounset -o errtrace

readonly RUNTIME_DIR='{{ mvp_runtime_dir }}'
readonly PARAMETER_PATH='{{ mvp_runtime_parameter_path }}'
temporary=''

error() { echo "[ERROR] $*" >&2; exit 1; }
require_command() { command -v "$1" >/dev/null 2>&1 || error "Required command not found: $1"; }

cleanup() {
  [[ -z "${temporary}" ]] || rm -f "${temporary}"
}

render_group_env() {
  local group="$1"
  local destination="${RUNTIME_DIR}/${group}.env"
  [[ "${group}" =~ ^[a-z][a-z0-9-]*$ ]] || error "Invalid runtime parameter group: ${group}"
  temporary="$(mktemp "${RUNTIME_DIR}/.${group}.env.XXXXXX")"

  aws ssm get-parameters-by-path \
    --path "${PARAMETER_PATH}/${group}" \
    --recursive \
    --with-decryption \
    --output json \
    | jq -r '
        .Parameters[]
        | (.Name | split("/") | last) as $name
        | if ($name | test("^[A-Z][A-Z0-9_]*$")) then "\($name)=\(.Value)" else empty end
      ' > "${temporary}"

  [[ -s "${temporary}" ]] || error "No valid parameters found for ${group}."
  chown root:root "${temporary}"
  chmod 0600 "${temporary}"
  mv "${temporary}" "${destination}"
  temporary=''
}

main() {
  (($# > 0)) || error "Usage: api-observatory-mvp-render-env <group>..."
  require_command aws
  require_command jq
  install -d -m 0700 -o root -g root "${RUNTIME_DIR}"
  local group
  for group in "$@"; do
    render_group_env "${group}"
  done
}

trap 'error "Runtime environment rendering failed at line ${LINENO}"' ERR
trap cleanup EXIT
main "$@"
