# AWS Dev Environment
# Copy to terraform.tfvars and fill in values

aws_region         = "us-east-1"
project            = "some-project"

instance_type = "t2.micro" # Free tier: 750 hrs/month for 12 months
# Leave null to create the GitHub Actions OIDC provider. Supply an existing ARN
# only when the AWS account already manages this singleton outside this state.
github_oidc_provider_arn = null

# Example only. Replace locally in terraform.tfvars.
allowed_admin_cidr = "203.0.113.10/32"
